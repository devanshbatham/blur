{
  "name": "blur",
  "version": "1.0.0",
  "description": "Hand-written rules for masking PII and secrets, compiled into a 609 KB neural network.",
  "keywords": [
    "pii",
    "privacy",
    "redaction",
    "masking",
    "secrets",
    "browser",
    "offline",
    "neural-network"
  ],
  "type": "module",
  "main": "./sdk/index.js",
  "types": "./sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "default": "./sdk/index.js"
    },
    "./engine": "./web/engine.js",
    "./pipeline": "./web/postprocess.js",
    "./model": "./web/model-general.bin"
  },
  "bin": {
    "blur": "cli/blur.mjs"
  },
  "files": [
    "sdk/",
    "cli/",
    "web/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "devanshbatham",
  "repository": {
    "type": "git",
    "url": "https://github.com/devanshbatham/blur"
  }
}
